#!/usr/bin/env bash
# Wrapper around `gh` that authenticates as a GitHub App bot instead of the
# caller's own `gh auth login` session, so automated comments (Claude Code,
# Codex, etc.) show up as the bot.
#
# Config (env vars, typically loaded from a gitignored .env):
#   GH_BOT_APP_ID           GitHub App ID
#   GH_BOT_PRIVATE_KEY_PATH Path to the App's private key (.pem)
#
# The installation ID is looked up per-repo at runtime (via the App's JWT),
# so the same App/key work across any org/account the App is installed on.
#
# Usage:
#   gh-bot comment --repo owner/repo --number 123 ["text"]
#   gh-bot reply --repo owner/repo --pr 123 --comment-id ID ["text"]
#   gh-bot issue-create --repo owner/repo --title "Title" ["body text"]
#   gh-bot issue-update --repo owner/repo --number 123 [--title T] [--state open|closed] ["body text"]
#
# If "text"/body is omitted, the body is read from stdin.

set -euo pipefail

print_help() {
  cat <<'EOF'
gh-bot — post issue/PR comments as a GitHub App bot

USAGE:
  gh-bot <command> [options]
  gh-bot <command> --help   Show options for a specific command

COMMANDS:
  comment          Post a general comment on an issue or PR
  reply            Reply to an existing PR review (line) comment thread
  issue-create     Create a new issue
  issue-update     Update an existing issue (title/body/state/labels/assignees)

CONFIG (env vars, typically loaded from a gitignored .env next to this script):
  GH_BOT_APP_ID           GitHub App ID
  GH_BOT_PRIVATE_KEY_PATH Path to the App's private key (.pem)

  The installation ID is looked up per-repo at runtime (via the App's JWT),
  so the same App/key work across any org/account the App is installed on.
EOF
}

print_comment_help() {
  cat <<'EOF'
gh-bot comment — post a general comment on an issue or PR

USAGE:
  gh-bot comment --repo owner/repo --number N ["text"]

OPTIONS:
  --repo owner/repo    Target repository (required)
  --number N           Issue or PR number (required)
  --body, --comment    Comment body (or pass as a trailing positional arg)
  [text]               Comment body; if omitted (and no --body), read from stdin

EXAMPLES:
  gh-bot comment --repo owner/repo --number 123 "Looks good to me."
  gh-bot comment --repo owner/repo --number 123 --body "Looks good to me."
  gh-bot comment --repo owner/repo --number 123 <<'BODY'
  Multi-line
  comment body.
  BODY
EOF
}

print_reply_help() {
  cat <<'EOF'
gh-bot reply — reply to an existing PR review (line) comment thread

USAGE:
  gh-bot reply --repo owner/repo --pr N --comment-id ID ["text"]

OPTIONS:
  --repo owner/repo    Target repository (required)
  --pr N               Pull request number (required)
  --comment-id ID      ID of the review comment to reply to (required)
  --body, --comment    Reply body (or pass as a trailing positional arg)
  [text]               Reply body; if omitted (and no --body), read from stdin

Find --comment-id via the review comment's API URL/webhook payload (the
"id" field), or `gh api repos/OWNER/REPO/pulls/N/comments` to list them.

EXAMPLE:
  gh-bot reply --repo owner/repo --pr 123 --comment-id 987654321 \
    "Fixed in a1b2c3d, thanks!"
EOF
}

print_issue_create_help() {
  cat <<'EOF'
gh-bot issue-create — create a new issue

USAGE:
  gh-bot issue-create --repo owner/repo --title "Title" ["body text"]

OPTIONS:
  --repo owner/repo    Target repository (required)
  --title TEXT         Issue title (required)
  --label NAME         Add a label (repeatable)
  --assignee USER      Add an assignee (repeatable)
  --body, --comment    Issue body (or pass as a trailing positional arg)
  [text]               Issue body; if omitted (and no --body), read from stdin

EXAMPLES:
  gh-bot issue-create --repo owner/repo --title "Bug: crash on save" "Steps to reproduce..."
  gh-bot issue-create --repo owner/repo --title "Bug" --label bug --label needs-triage \
    --assignee octocat --body "Details here"
EOF
}

print_issue_update_help() {
  cat <<'EOF'
gh-bot issue-update — update an existing issue

USAGE:
  gh-bot issue-update --repo owner/repo --number N [options] ["body text"]

OPTIONS:
  --repo owner/repo    Target repository (required)
  --number N           Issue number (required)
  --title TEXT         New title
  --state open|closed  New state
  --label NAME         Set labels to this list (repeatable; replaces existing labels)
  --assignee USER      Set assignees to this list (repeatable; replaces existing assignees)
  --body, --comment    New body (or pass as a trailing positional arg)
  [text]               New body; if omitted (and no --body/--title/--state/...), read from stdin

At least one of --title/--state/--label/--assignee/body must be given.
--label and --assignee REPLACE the full existing list, not append.

EXAMPLES:
  gh-bot issue-update --repo owner/repo --number 42 --state closed
  gh-bot issue-update --repo owner/repo --number 42 --title "New title" --label bug --label p1
EOF
}

case "${1:-}" in
  ""|help)
    print_help
    exit 0
    ;;
  comment)
    for arg in "$@"; do [[ "$arg" == "-h" || "$arg" == "--help" ]] && { print_comment_help; exit 0; }; done
    ;;
  reply)
    for arg in "$@"; do [[ "$arg" == "-h" || "$arg" == "--help" ]] && { print_reply_help; exit 0; }; done
    ;;
  issue-create)
    for arg in "$@"; do [[ "$arg" == "-h" || "$arg" == "--help" ]] && { print_issue_create_help; exit 0; }; done
    ;;
  issue-update)
    for arg in "$@"; do [[ "$arg" == "-h" || "$arg" == "--help" ]] && { print_issue_update_help; exit 0; }; done
    ;;
  -h|--help)
    print_help
    exit 0
    ;;
esac

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" = /* ]]; then
    script_path="$link_target"
  else
    script_path="$(dirname "$script_path")/$link_target"
  fi
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
if [[ -f "$script_dir/../.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$script_dir/../.env"
  set +a
fi

: "${GH_BOT_APP_ID:?GH_BOT_APP_ID is not set}"
: "${GH_BOT_PRIVATE_KEY_PATH:?GH_BOT_PRIVATE_KEY_PATH is not set}"

# A relative GH_BOT_PRIVATE_KEY_PATH is relative to the repo root (next to
# .env), not to the caller's cwd, so gh-bot works the same from anywhere.
if [[ "$GH_BOT_PRIVATE_KEY_PATH" != /* ]]; then
  GH_BOT_PRIVATE_KEY_PATH="$script_dir/../$GH_BOT_PRIVATE_KEY_PATH"
fi
if [[ ! -f "$GH_BOT_PRIVATE_KEY_PATH" ]]; then
  echo "GH_BOT_PRIVATE_KEY_PATH does not exist: $GH_BOT_PRIVATE_KEY_PATH" >&2
  exit 1
fi

base64url() {
  base64 -w0 | tr '+/' '-_' | tr -d '='
}

make_jwt() {
  local now iat exp header payload signing_input signature
  now=$(date +%s)
  iat=$((now - 60))
  exp=$((now + 570)) # max allowed lifetime is 10 minutes

  header=$(printf '{"alg":"RS256","typ":"JWT"}' | base64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$iat" "$exp" "$GH_BOT_APP_ID" | base64url)
  signing_input="${header}.${payload}"
  signature=$(printf '%s' "$signing_input" | openssl dgst -sha256 -sign "$GH_BOT_PRIVATE_KEY_PATH" | base64url)

  printf '%s.%s' "$signing_input" "$signature"
}

get_installation_id() {
  local repo="$1" jwt response id
  jwt=$(make_jwt)
  response=$(curl -sS \
    -H "Authorization: Bearer $jwt" \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/${repo}/installation")
  id=$(printf '%s' "$response" | jq -r '.id // empty')
  if [[ -z "$id" ]]; then
    echo "Could not find an installation of the App for ${repo}. Is it installed there?" >&2
    echo "$response" >&2
    exit 1
  fi
  printf '%s' "$id"
}

get_installation_token() {
  local repo="$1" installation_id jwt
  installation_id=$(get_installation_id "$repo")
  jwt=$(make_jwt)
  curl -sS -X POST \
    -H "Authorization: Bearer $jwt" \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app/installations/${installation_id}/access_tokens" \
    | jq -r '.token'
}

read_body() {
  # Prints the given text arg, or reads stdin if none was given.
  if [[ $# -gt 0 ]]; then
    printf '%s' "$1"
  else
    cat
  fi
}

cmd_comment() {
  local repo="" number="" body_arg=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --number) number="$2"; shift 2 ;;
      --body|--comment) body_arg=("$2"); shift 2 ;;
      --*) echo "gh-bot comment: unknown option '$1'" >&2; exit 1 ;;
      *) body_arg+=("$1"); shift ;;
    esac
  done
  [[ -n "$repo" && -n "$number" ]] || { echo "usage: gh-bot comment --repo owner/repo --number N [text]" >&2; exit 1; }

  local body token
  body=$(read_body "${body_arg[@]:-}")
  token=$(get_installation_token "$repo")

  GH_TOKEN="$token" gh api "repos/${repo}/issues/${number}/comments" -f body="$body" >/dev/null
  echo "Comment posted on ${repo}#${number}"
}

cmd_reply() {
  local repo="" pr="" comment_id="" body_arg=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --pr) pr="$2"; shift 2 ;;
      --comment-id) comment_id="$2"; shift 2 ;;
      --body|--comment) body_arg=("$2"); shift 2 ;;
      --*) echo "gh-bot reply: unknown option '$1'" >&2; exit 1 ;;
      *) body_arg+=("$1"); shift ;;
    esac
  done
  [[ -n "$repo" && -n "$pr" && -n "$comment_id" ]] || {
    echo "usage: gh-bot reply --repo owner/repo --pr N --comment-id ID [text]" >&2
    exit 1
  }

  local body token
  body=$(read_body "${body_arg[@]:-}")
  token=$(get_installation_token "$repo")

  GH_TOKEN="$token" gh api "repos/${repo}/pulls/${pr}/comments/${comment_id}/replies" -f body="$body" >/dev/null
  echo "Reply posted on ${repo}#${pr} (in reply to comment ${comment_id})"
}

cmd_issue_create() {
  local repo="" title="" body_arg=() labels=() assignees=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --label) labels+=("$2"); shift 2 ;;
      --assignee) assignees+=("$2"); shift 2 ;;
      --body|--comment) body_arg=("$2"); shift 2 ;;
      --*) echo "gh-bot issue-create: unknown option '$1'" >&2; exit 1 ;;
      *) body_arg+=("$1"); shift ;;
    esac
  done
  [[ -n "$repo" && -n "$title" ]] || {
    echo "usage: gh-bot issue-create --repo owner/repo --title TEXT [text]" >&2
    exit 1
  }

  local body token fields=() label assignee response number url
  body=$(read_body "${body_arg[@]:-}")
  for label in "${labels[@]:-}"; do
    [[ -n "$label" ]] && fields+=(-f "labels[]=$label")
  done
  for assignee in "${assignees[@]:-}"; do
    [[ -n "$assignee" ]] && fields+=(-f "assignees[]=$assignee")
  done
  token=$(get_installation_token "$repo")

  response=$(GH_TOKEN="$token" gh api "repos/${repo}/issues" -f title="$title" -f body="$body" "${fields[@]}")
  number=$(printf '%s' "$response" | jq -r '.number')
  url=$(printf '%s' "$response" | jq -r '.html_url')
  echo "Issue created: ${repo}#${number} ($url)"
}

cmd_issue_update() {
  local repo="" number="" title="" state="" body_arg=() body_provided=0 labels=() assignees=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --number) number="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --state) state="$2"; shift 2 ;;
      --label) labels+=("$2"); shift 2 ;;
      --assignee) assignees+=("$2"); shift 2 ;;
      --body|--comment) body_arg=("$2"); body_provided=1; shift 2 ;;
      --*) echo "gh-bot issue-update: unknown option '$1'" >&2; exit 1 ;;
      *) body_arg+=("$1"); body_provided=1; shift ;;
    esac
  done
  [[ -n "$repo" && -n "$number" ]] || {
    echo "usage: gh-bot issue-update --repo owner/repo --number N [options] [text]" >&2
    exit 1
  }
  if [[ -n "$state" && "$state" != "open" && "$state" != "closed" ]]; then
    echo "gh-bot issue-update: --state must be 'open' or 'closed'" >&2
    exit 1
  fi
  if [[ -z "$title" && -z "$state" && "$body_provided" -eq 0 && ${#labels[@]} -eq 0 && ${#assignees[@]} -eq 0 ]]; then
    echo "gh-bot issue-update: nothing to update — pass --title/--state/--label/--assignee or a body" >&2
    exit 1
  fi

  local body token fields=() label assignee
  [[ -n "$title" ]] && fields+=(-f "title=$title")
  [[ -n "$state" ]] && fields+=(-f "state=$state")
  if [[ "$body_provided" -eq 1 ]]; then
    body=$(read_body "${body_arg[@]:-}")
    fields+=(-f "body=$body")
  fi
  for label in "${labels[@]:-}"; do
    [[ -n "$label" ]] && fields+=(-f "labels[]=$label")
  done
  for assignee in "${assignees[@]:-}"; do
    [[ -n "$assignee" ]] && fields+=(-f "assignees[]=$assignee")
  done
  token=$(get_installation_token "$repo")

  GH_TOKEN="$token" gh api --method PATCH "repos/${repo}/issues/${number}" "${fields[@]}" >/dev/null
  echo "Issue updated: ${repo}#${number}"
}

main() {
  local sub="${1:-}"
  [[ $# -gt 0 ]] && shift || true
  case "$sub" in
    comment) cmd_comment "$@" ;;
    reply) cmd_reply "$@" ;;
    issue-create) cmd_issue_create "$@" ;;
    issue-update) cmd_issue_update "$@" ;;
    *)
      echo "usage: gh-bot <comment|reply|issue-create|issue-update> [options]" >&2
      exit 1
      ;;
  esac
}

main "$@"
